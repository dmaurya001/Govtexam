# GovtExamHub AI Server — Environment Variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the actual .env to git.

# ============================================================
# AI PROVIDERS
# ============================================================

# PRIMARY: Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# SECONDARY: OpenAI (used only for validation/regeneration fallback)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# SERVER CONFIG
# ============================================================
PORT=3001
NODE_ENV=production

# Frontend origin for CORS (your Netlify/Vercel URL or localhost)
ALLOWED_ORIGINS=http://localhost:8080,https://your-netlify-site.netlify.app

# ============================================================
# ADMIN SECRET (used to protect admin API routes)
# ============================================================
ADMIN_SECRET=change_this_to_a_strong_secret_here

# ============================================================
# PAPER GENERATION CONFIG (override defaults)
# ============================================================
MAX_BATCH_SIZE=35
GENERATION_TIMEOUT_MS=60000
ENABLE_OPENAI_CROSSVALIDATION=false
